# U-Word 投稿管理ツール — 環境変数設定例
# このファイルをコピーして .env を作成: cp .env.example .env

# === 必須 ===
# auto-poster バックエンドのパス（DB・認証情報・投稿アダプタを参照）
AP_BACKEND=/path/to/auto-poster/backend

# Gemini API キー（AI記事生成・週次レビュー用）
GEMINI_API_KEY=your_gemini_api_key_here

# === オプション ===
# CORS 許可オリジン（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# 設定ファイルのパス（デフォルト: backend/ 直下）
UWORD_SETTINGS_PATH=/path/to/uword-poster-ui/backend/auto_settings.json
UWORD_BOILERPLATE_PATH=/path/to/uword-poster-ui/backend/boilerplate.json
UWORD_REPORTS_DIR=/path/to/auto-poster/reports/weekly
UWORD_SCHEDULER_DB=/path/to/uword-poster-ui/backend/scheduler_jobs.db
