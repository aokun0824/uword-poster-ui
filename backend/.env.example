# ==============================
# U-Word 投稿管理ツール — 環境設定
# ==============================
# このファイルをコピーして .env を作成: cp .env.example .env

# === 必須 ===
# auto-poster バックエンドのパス（autopost.db が含まれるディレクトリ）
# 別途 https://github.com/kodawarimax/auto-poster をクローンしてパスを指定
# Docker 使用時は docker-compose.yml の environment で上書きされるため不要
AP_BACKEND=./auto-poster/backend

# Gemini API キー（AI記事生成・週次レビュー用）
GEMINI_API_KEY=your_gemini_api_key_here

# === オプション ===
# CORS 許可オリジン（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# スケジューラ DB パス（デフォルトはバックエンド直下）
# UWORD_SCHEDULER_DB=./backend/scheduler_jobs.db

# ボイラープレート設定ファイル
# UWORD_BOILERPLATE_PATH=./backend/boilerplate.json

# 設定ファイルのパス（デフォルト: backend/ 直下）
# UWORD_SETTINGS_PATH=./backend/auto_settings.json
# UWORD_REPORTS_DIR=./auto-poster/reports/weekly
